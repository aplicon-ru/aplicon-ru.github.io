---
import Layout from "../layouts/Layout.astro";

const areas = [
  { title: "Численные методы", text: "Модели физических и производственных процессов, оптимизация расчётов под ограниченные ресурсы." },
  { title: "Машинное обучение", text: "Прикладные модели для задач с малыми и «грязными» данными: где обычный подход не работает." },
  { title: "Инженерия данных", text: "Архитектура сбора и обработки потоков, воспроизводимость вычислительных экспериментов." },
  { title: "Методика обучения", text: "Как быстро выводить инженера на рабочий уровень в новой области. Проверяем на своих программах." },
];

const pubs = [
  { year: "2026", title: "Ускорение инженерных расчётов на разреженных сетках", meta: "Сборник конференции · препринт" },
  { year: "2025", title: "Обучение моделей на малых промышленных выборках", meta: "Научный журнал · статья" },
  { year: "2025", title: "Воспроизводимость вычислительных экспериментов в прикладных проектах", meta: "Технический отчёт" },
  { year: "2024", title: "Практика наставничества в инженерных командах", meta: "Доклад · материалы семинара" },
];
---
<Layout title="Исследования и публикации — Апликон">
  <main>
    <section style="max-width:1220px;margin:0 auto;padding:clamp(48px,6vw,88px) 24px clamp(36px,4vw,56px)">
      <div style="font-size:12.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:#E8A94D;margin-bottom:18px">Исследования и публикации</div>
      <h1 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(30px,4.4vw,50px);line-height:1.12;margin:0 0 20px;max-width:24ch;text-wrap:pretty">Исследуем то, что потом идёт в продукт</h1>
      <p style="font-size:clamp(16px,1.3vw,18px);line-height:1.62;color:rgba(245,246,247,.72);max-width:62ch;margin:0;text-wrap:pretty">Исследовательская часть работы не изолирована от инженерной. Результаты попадают в наши проекты, в курсы и в открытые публикации.</p>
    </section>
    <section style="max-width:1220px;margin:0 auto;padding:0 24px clamp(44px,5vw,72px)">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px">
        {areas.map(a => (
          <div style="border:1px solid rgba(245,246,247,.11);border-radius:16px;padding:26px">
            <h3 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:18px;margin:0 0 12px">{a.title}</h3>
            <p style="font-size:14.5px;line-height:1.58;color:rgba(245,246,247,.68);margin:0">{a.text}</p>
          </div>
        ))}
      </div>
    </section>
    <section style="background:#242F3D;border-top:1px solid rgba(245,246,247,.09)">
      <div style="max-width:1220px;margin:0 auto;padding:clamp(48px,6vw,84px) 24px">
        <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(23px,2.8vw,32px);line-height:1.18;margin:0 0 30px">Публикации</h2>
        <div style="display:grid;gap:0">
          {pubs.map((p, i) => (
            <div style={`display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:22px;align-items:baseline;padding:22px 0;border-top:1px solid rgba(245,246,247,.12)${i === pubs.length - 1 ? ";border-bottom:1px solid rgba(245,246,247,.12)" : ""}`}>
              <span style="font-family:'Unbounded',sans-serif;font-size:13px;color:#E8A94D">{p.year}</span>
              <div><div style="font-size:16.5px;font-weight:600;line-height:1.4;margin-bottom:6px;text-wrap:pretty">{p.title}</div><div style="font-size:13.5px;color:rgba(245,246,247,.6)">{p.meta}</div></div>
              <span style="font-size:13.5px;color:rgba(245,246,247,.5);white-space:nowrap">PDF</span>
            </div>
          ))}
        </div>
        <p style="font-size:13.5px;color:rgba(245,246,247,.62);margin:24px 0 0">Список черновой — заменим на реальные работы и ссылки.</p>
      </div>
    </section>
  </main>
</Layout>
