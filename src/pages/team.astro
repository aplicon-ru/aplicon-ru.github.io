---
import Layout from "../layouts/Layout.astro";

const people = [
  { name: "Александр", role: "архитектор и вдохновитель", text: "Отвечает за то, как всё устроено: от модели предметной области до контрактов между системами. Больше 25 лет в 1С, от 7.7 до 8.5." },
  { name: "Дизайнер", role: null, text: "Интерфейсы, фирменный стиль, печатные материалы." },
  { name: "Системный администратор", role: null, text: "Серверы, сети, доступы, работа систем в бою." },
  { name: "Разработчики", role: null, text: "Подключаются под проект. В том числе выпускники и стажёры Академии — под присмотром архитектора." },
];

const directions = [
  { title: "Разработка", text: "Свои продукты и работа под заказчика.", link: "/works", label: "Работы →" },
  { title: "Обучение", text: "Академия iMiron: готовим 1С-инженеров.", link: "https://academ.aplicon.ru", label: "academ.aplicon.ru ↗", external: true },
  { title: "Исследования", text: "Открытые модели предметных областей.", link: "https://github.com/aplicon-ru", label: "GitHub ↗", external: true },
  { title: "Технологии", text: "Чем работаем и почему так.", link: "/tech", label: "Технологии →" },
];
---
<Layout title="Команда — Апликон" active="team">
  <main>
    <section style="max-width:1060px;margin:0 auto;padding:clamp(48px,6vw,88px) 24px clamp(30px,4vw,48px)">
      <h1 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(30px,4.4vw,50px);line-height:1.14;margin:0 0 22px;max-width:22ch;text-wrap:pretty">Команда собирается под проект</h1>
      <p style="font-size:clamp(16px,1.3vw,18px);line-height:1.62;color:rgba(245,246,247,.82);max-width:60ch;margin:0;text-wrap:pretty">Постоянно — архитектор, дизайнер и системный администратор. Под задачу подключаем разработчиков: часть из них мы выучили сами, в своей Академии.</p>
      <p style="font-size:clamp(14px,1.05vw,15.5px);line-height:1.6;color:rgba(245,246,247,.6);max-width:60ch;margin:22px 0 0;text-wrap:pretty">Мы не держим людей в простое и не берём проектов больше, чем способны понять. Если на задачу нужно пятьдесят человек — это не к нам.</p>
    </section>

    <section style="max-width:1060px;margin:0 auto;padding:0 24px clamp(20px,3vw,32px)">
      <div style="display:grid">
        {people.map((p, i) => (
          <div class="ap-2col" style={`display:grid;grid-template-columns:minmax(0,320px) minmax(0,1fr);gap:clamp(10px,3vw,40px);padding:26px 4px;border-top:1px solid rgba(245,246,247,.14)${i === people.length - 1 ? ";border-bottom:1px solid rgba(245,246,247,.14)" : ""}`}>
            {p.role ? (
              <div>
                <div style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(17px,1.5vw,19px);line-height:1.3">{p.name}</div>
                <div style="font-size:14px;line-height:1.5;color:#E8A94D;margin-top:7px">{p.role}</div>
              </div>
            ) : (
              <div style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(17px,1.5vw,19px);line-height:1.3">{p.name}</div>
            )}
            <p style="font-size:15.5px;line-height:1.6;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">{p.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section style="max-width:1060px;margin:0 auto;padding:clamp(40px,5vw,64px) 24px clamp(20px,3vw,32px)">
      <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(21px,2.4vw,28px);line-height:1.2;margin:0 0 clamp(18px,2.5vw,28px)">Направления</h2>
      <div style="display:grid">
        {directions.map((d, i) => (
          <div class="ap-2col" style={`display:grid;grid-template-columns:minmax(0,320px) minmax(0,1fr);gap:clamp(10px,3vw,40px);padding:24px 4px;border-top:1px solid rgba(245,246,247,.14)${i === directions.length - 1 ? ";border-bottom:1px solid rgba(245,246,247,.14)" : ""}`}>
            <div style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(16px,1.4vw,18px);line-height:1.3">{d.title}</div>
            <div style="display:grid;gap:10px;min-width:0">
              <p style="font-size:15.5px;line-height:1.6;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">{d.text}</p>
              <a href={d.link} target={d.external ? "_blank" : undefined} rel={d.external ? "noopener" : undefined} style="font-size:15px;font-weight:600;color:#E8A94D;justify-self:start">{d.label}</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section style="max-width:1060px;margin:0 auto;padding:clamp(40px,5vw,64px) 24px clamp(64px,9vw,112px)">
      <p style="font-size:clamp(17px,1.7vw,22px);line-height:1.5;color:#F5F6F7;margin:0;max-width:46ch;text-wrap:pretty">Ищем тех, кто любит разбираться. Напишите → <a href="mailto:hello@aplicon.ru" style="color:#E8A94D;font-weight:600">hello@aplicon.ru</a></p>
    </section>
  </main>
</Layout>
