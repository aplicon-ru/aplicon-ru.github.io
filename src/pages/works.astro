---
import Layout from "../layouts/Layout.astro";

const products = [
  { name: "Универкон", status: "в разработке", href: "/products/univerkon", text: "Управление вузом, колледжем и центром ДПО: контингент, учебные планы, приказы, личные кабинеты. Ставится на серверы заказчика." },
  { name: "Архикон", status: "в разработке", text: "Резервное копирование баз 1С. Ставится рядом с базами, находит их сам, копирует по расписанию и восстанавливает." },
  { name: "Лицензикон и Активикон", status: "в разработке", text: "Лицензии, активации и подписки на обновления для коммерческих расширений 1С." },
  { name: "Метакон", status: "замысел", text: "Тренажёр для подготовки к экзамену 1С:Специалист: задачи генерируются, решение проверяется автоматически." },
  { name: "Ярлыкон", status: "работает", text: "Сокращатель ссылок со своей статистикой и Telegram Mini App." },
  { name: "Тестикон", status: "замысел", text: "Среда прогона тестов для 1С-разработки." },
];

const projects = [
  { title: "Цифровизация медицинского вуза", text: "Архитектура информационных систем, интеграции, перевод бумажных процессов в учёт." },
  { title: "Переход с Active Directory на ALD Pro", text: "Служба каталога без иностранного ПО: пользователи, политики, рабочие места." },
  { title: "Почтовый сервер корпоративного домена", text: "Свой сервер вместо арендованных ящиков: домен, защита, резервные копии." },
  { title: "Единый архив образовательных программ", text: "Все программы по специальностям и годам набора собраны в один контур с понятной структурой." },
  { title: "Сопровождение иностранных студентов", text: "Регламент работы с образовательным рекрутером: документы, учёт, сопровождение." },
];

function badgeStyle(status: string) {
  if (status === "работает" || status === "открытый код") {
    return "border:1px solid rgba(232,169,77,.55);color:#E8A94D";
  }
  return "border:1px solid rgba(245,246,247,.28);color:rgba(245,246,247,.6)";
}
---
<Layout title="Работы — Апликон" active="works">
  <main>
    <section style="max-width:1060px;margin:0 auto;padding:clamp(48px,6vw,88px) 24px clamp(28px,3vw,44px)">
      <h1 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(30px,4.4vw,50px);line-height:1.12;margin:0 0 20px;text-wrap:pretty">Работы</h1>
      <p style="font-size:clamp(15px,1.2vw,17px);line-height:1.6;color:rgba(245,246,247,.66);max-width:58ch;margin:0;text-wrap:pretty">Свои продукты, проекты для заказчиков и отдельные работы.</p>
      <nav style="display:flex;flex-wrap:wrap;gap:8px 22px;margin-top:clamp(26px,3vw,36px);font-size:14.5px;font-weight:600">
        <a href="#works-products" style="color:#E8A94D">Продукты</a>
        <span style="color:rgba(245,246,247,.3)">·</span>
        <a href="#works-projects" style="color:#E8A94D">Проекты</a>
        <span style="color:rgba(245,246,247,.3)">·</span>
        <a href="#works-portfolio" style="color:#E8A94D">Портфолио</a>
      </nav>
    </section>

    <section id="works-products" style="max-width:1060px;margin:0 auto;padding:clamp(30px,4vw,48px) 24px clamp(20px,3vw,32px);scroll-margin-top:90px">
      <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(21px,2.4vw,28px);line-height:1.2;margin:0 0 12px">Продукты</h2>
      <p style="font-size:15px;line-height:1.6;color:rgba(245,246,247,.66);max-width:56ch;margin:0 0 clamp(18px,2.5vw,28px);text-wrap:pretty">Своё, тиражируемое: ставим не одному заказчику, развиваем сами.</p>
      <div style="display:grid">
        {products.map((p, i) => (
          <div style={`display:grid;grid-template-columns:minmax(0,300px) minmax(0,1fr);gap:clamp(10px,3vw,40px);padding:24px 4px;border-top:1px solid rgba(245,246,247,.14)${i === products.length - 1 ? ";border-bottom:1px solid rgba(245,246,247,.14)" : ""}`}>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
              {p.href ? (
                <a href={p.href} style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(17px,1.5vw,19px);line-height:1.3;color:#F5F6F7">{p.name}</a>
              ) : (
                <span style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(17px,1.5vw,19px);line-height:1.3">{p.name}</span>
              )}
              <span style={`font-size:11.5px;letter-spacing:.04em;padding:4px 10px;border-radius:99px;white-space:nowrap;${badgeStyle(p.status)}`}>{p.status}</span>
            </div>
            <p style="font-size:15.5px;line-height:1.6;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">{p.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="works-projects" style="max-width:1060px;margin:0 auto;padding:clamp(34px,4vw,56px) 24px clamp(20px,3vw,32px);scroll-margin-top:90px">
      <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(21px,2.4vw,28px);line-height:1.2;margin:0 0 12px">Проекты</h2>
      <p style="font-size:15px;line-height:1.6;color:rgba(245,246,247,.66);max-width:56ch;margin:0 0 clamp(18px,2.5vw,28px);text-wrap:pretty">Работа для конкретного заказчика: архитектура, внедрение, миграция.</p>
      <div style="display:grid">
        {projects.map((p, i) => (
          <div style={`display:grid;grid-template-columns:minmax(0,300px) minmax(0,1fr);gap:clamp(10px,3vw,40px);padding:24px 4px;border-top:1px solid rgba(245,246,247,.14)${i === projects.length - 1 ? ";border-bottom:1px solid rgba(245,246,247,.14)" : ""}`}>
            <span style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(16px,1.4vw,18px);line-height:1.34;text-wrap:pretty">{p.title}</span>
            <p style="font-size:15.5px;line-height:1.6;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">{p.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="works-portfolio" style="max-width:1060px;margin:0 auto;padding:clamp(34px,4vw,56px) 24px clamp(64px,9vw,112px);scroll-margin-top:90px">
      <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(21px,2.4vw,28px);line-height:1.2;margin:0 0 12px">Портфолио</h2>
      <p style="font-size:15px;line-height:1.6;color:rgba(245,246,247,.66);max-width:56ch;margin:0 0 clamp(18px,2.5vw,28px);text-wrap:pretty">Отдельные работы: сайты, компоненты, утилиты.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:14px">
        <div style="background:#242F3D;border:1px solid rgba(245,246,247,.09);border-radius:14px;padding:22px 24px;display:flex;flex-direction:column;gap:12px">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
            <span style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:17px;line-height:1.3">mailstack</span>
            <span style="font-size:11.5px;letter-spacing:.04em;padding:4px 10px;border-radius:99px;border:1px solid rgba(232,169,77,.55);color:#E8A94D;white-space:nowrap">открытый код</span>
          </div>
          <p style="font-size:15px;line-height:1.55;color:rgba(245,246,247,.8);margin:0;text-wrap:pretty">Почтовый сервер для нескольких доменов на одном VPS: развёртывание и сорок проверок одной командой.</p>
          <div style="display:grid;gap:8px;justify-items:start;margin-top:auto;font-size:14.5px;font-weight:600">
            <a href="#" target="_blank" rel="noopener" style="color:#E8A94D">GitHub ↗</a>
            <a href="/blog/mailstack" style="color:#E8A94D">Как это устроено →</a>
          </div>
        </div>
        <div style="background:#242F3D;border:1px solid rgba(245,246,247,.09);border-radius:14px;padding:22px 24px;font-size:15.5px;line-height:1.5;color:rgba(245,246,247,.88);text-wrap:pretty">Сайт магазина швейцарских часов goldmean.ru</div>
        <div style="background:#242F3D;border:1px solid rgba(245,246,247,.09);border-radius:14px;padding:22px 24px;font-size:15.5px;line-height:1.5;color:rgba(245,246,247,.88);text-wrap:pretty">Сайт производителя печатей и штампов</div>
        <div style="background:#242F3D;border:1px solid rgba(245,246,247,.09);border-radius:14px;padding:22px 24px;font-size:15.5px;line-height:1.5;color:rgba(245,246,247,.88);text-wrap:pretty">Внешняя компонента для 1С: генерация RSA-ключей, JWK/JWKS, подпись RS256 без внешних утилит</div>
        <div style="background:#242F3D;border:1px solid rgba(245,246,247,.09);border-radius:14px;padding:22px 24px;font-size:15.5px;line-height:1.5;color:rgba(245,246,247,.88);text-wrap:pretty">Автоматическая установка платформы 1С</div>
        <div style="background:#242F3D;border:1px solid rgba(245,246,247,.09);border-radius:14px;padding:22px 24px;font-size:15.5px;line-height:1.5;color:rgba(245,246,247,.88);text-wrap:pretty">Тихая установка MS SQL и PostgreSQL под 1С</div>
      </div>
    </section>
  </main>
</Layout>
