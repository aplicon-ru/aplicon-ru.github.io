---
import Layout from "../../layouts/Layout.astro";
import posts from "../../data/blog-posts.json";
---
<Layout title="Блог — Апликон">
  <main>
    <section style="max-width:820px;margin:0 auto;padding:clamp(48px,6vw,88px) 24px clamp(26px,3vw,40px)">
      <h1 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(30px,4.4vw,50px);line-height:1.12;margin:0 0 18px">Блог</h1>
      <p style="font-size:clamp(15px,1.2vw,17px);line-height:1.6;color:rgba(245,246,247,.66);max-width:56ch;margin:0;text-wrap:pretty">Разборы задач, которые мы решали у себя или у заказчика.</p>
    </section>
    <section style="max-width:820px;margin:0 auto;padding:0 24px clamp(64px,9vw,112px)">
      <div style="display:grid">
        {posts.map(p => (
          <a href={p.href} class="ap-2col" style="display:grid;grid-template-columns:minmax(0,130px) minmax(0,1fr);gap:8px clamp(14px,3vw,32px);padding:26px 4px;border-top:1px solid rgba(245,246,247,.14);border-bottom:1px solid rgba(245,246,247,.14);color:#F5F6F7">
            <span style="font-size:14px;color:rgba(245,246,247,.62)">{p.date}</span>
            <span style="display:grid;gap:8px;min-width:0">
              <span style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(17px,1.6vw,20px);line-height:1.34;text-wrap:pretty">{p.title}</span>
              <span style="font-size:15px;line-height:1.6;color:rgba(245,246,247,.72);text-wrap:pretty">{p.text}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>
