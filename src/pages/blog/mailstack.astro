---
import Layout from "../../layouts/Layout.astro";
import toc from "../../data/mailstack-toc.json";
---
<Layout title="Своя почта для нескольких доменов на одном VPS — Апликон">
  <main>
    <div id="reading-progress" style="position:fixed;top:0;left:0;height:2px;background:#E8A94D;width:0%;z-index:60"></div>

    <div style="max-width:1140px;margin:0 auto;padding:0 24px;display:flex;flex-wrap:wrap;gap:0 clamp(24px,4vw,64px);align-items:stretch">

      <aside style="flex:1 1 180px;min-width:0;order:1">
        <div style="position:sticky;top:96px;padding:clamp(30px,4vw,64px) 0 28px">
          <div style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:rgba(245,246,247,.5);margin-bottom:16px">Содержание</div>
          <nav style="display:grid;gap:11px;font-size:13.5px;line-height:1.4">
            {toc.map(t => (
              <a href={`#${t.id}`} data-toc={t.id} style="display:grid;grid-template-columns:34px minmax(0,1fr);gap:10px;color:rgba(245,246,247,.62)">
                <span style="opacity:.9;font-family:'Silkscreen',ui-monospace,monospace;font-size:12px">{t.n}</span><span>{t.label}</span>
              </a>
            ))}
          </nav>
        </div>
      </aside>

      <div style="flex:6 1 600px;min-width:0;order:2">

        <section style="padding:clamp(30px,4vw,64px) 0 clamp(28px,3.5vw,40px)">
          <div style="display:flex;flex-wrap:wrap;align-items:baseline;gap:8px;font-size:13px;color:rgba(245,246,247,.6);margin-bottom:clamp(20px,3vw,30px)">
            <a href="/blog" style="color:rgba(245,246,247,.6)">Блог</a>
            <span style="color:rgba(245,246,247,.35)">→</span>
            <span>mailstack</span>
          </div>
          <h1 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(28px,4.2vw,46px);line-height:1.16;letter-spacing:-.005em;margin:0;text-wrap:pretty">Своя почта для нескольких доменов на одном VPS</h1>
          <p style="font-size:clamp(17px,1.5vw,21px);line-height:1.56;color:rgba(245,246,247,.86);margin:22px 0 0;max-width:50ch;text-wrap:pretty">Как выбирали площадку, обо что споткнулись и что получилось</p>
          <p style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12.5px;letter-spacing:.05em;line-height:1.5;color:rgba(245,246,247,.62);margin:26px 0 0">Сентябрь 2026 · разбор на ~20 минут</p>
        </section>

        <section id="a-result" data-sec style="padding:clamp(38px,5vw,60px) 0;border-top:1px solid rgba(245,246,247,.12);scroll-margin-top:88px">
          <div style="display:flex;align-items:baseline;gap:14px;margin-bottom:22px">
            <span style="font-family:'Silkscreen',ui-monospace,monospace;font-size:14px;color:#E8A94D">10</span>
            <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(21px,2.4vw,28px);line-height:1.22;margin:0;text-wrap:pretty">Коротко о результате</h2>
          </div>
          <div style="background:#242F3D;border:1px solid rgba(245,246,247,.09);border-radius:14px;padding:clamp(22px,3vw,30px)">
            <div style="display:grid;gap:16px;font-size:17px;line-height:1.64;color:rgba(245,246,247,.86)">
              <p style="margin:0;font-size:clamp(17.5px,1.7vw,20px);line-height:1.5;color:#F5F6F7;text-wrap:pretty">Один VPS обслуживает почту нескольких доменов: приём, отправка, IMAP, фильтрация спама, подпись писем. Развёртывание — одна команда, проверка состояния — вторая.</p>
              <p style="margin:0;text-wrap:pretty">Письма уходят в Gmail и Яндекс во «Входящие», а не в спам. DMARC-отчёты приходят и читаются.</p>
              <p style="margin:0;text-wrap:pretty">Считать это бесплатной заменой корпоративной почте не стоит: стоимость переезжает из подписки в час администратора. Смысл появляется, когда домены свои, ящиков десятки, а данные должны остаться на своём сервере.</p>
            </div>
          </div>
        </section>

        <section id="a-parts" data-sec style="padding:clamp(38px,5vw,60px) 0;border-top:1px solid rgba(245,246,247,.12);scroll-margin-top:88px">
          <div style="display:flex;align-items:baseline;gap:14px;margin-bottom:22px">
            <span style="font-family:'Silkscreen',ui-monospace,monospace;font-size:14px;color:#E8A94D">20</span>
            <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(21px,2.4vw,28px);line-height:1.22;margin:0;text-wrap:pretty">Из чего состоит</h2>
          </div>
          <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0 0 24px;max-width:64ch;text-wrap:pretty">Почтовый сервер — это не одна программа, а несколько служб, каждая со своей ролью. Разделение удобно тем, что любую часть можно заменить, не переписывая остальные.</p>
          <div style="overflow-x:auto;border:1px solid rgba(245,246,247,.14);border-radius:12px">
            <table style="width:100%;min-width:560px;border-collapse:collapse;font-size:15px">
              <thead>
                <tr style="background:#242F3D;text-align:left">
                  <th style="padding:14px 18px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:rgba(245,246,247,.7);font-weight:600;white-space:nowrap">Компонент</th>
                  <th style="padding:14px 18px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:rgba(245,246,247,.7);font-weight:600;white-space:nowrap">Роль</th>
                  <th style="padding:14px 18px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:rgba(245,246,247,.7);font-weight:600;white-space:nowrap">Порты</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);font-weight:600;white-space:nowrap">Postfix</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Приём и отправка писем, маршрутизация между доменами</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13.5px;color:rgba(245,246,247,.8);white-space:nowrap">25, 465, 587</td>
                </tr>
                <tr>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);font-weight:600;white-space:nowrap">Dovecot</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Хранение ящиков, доступ по IMAP, сортировка правилами Sieve</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13.5px;color:rgba(245,246,247,.8);white-space:nowrap">993</td>
                </tr>
                <tr>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);font-weight:600;white-space:nowrap">Rspamd</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Фильтрация спама, подпись DKIM, проверка SPF и DMARC на входе</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13.5px;color:rgba(245,246,247,.8);white-space:nowrap">локально</td>
                </tr>
                <tr>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);font-weight:600;white-space:nowrap">PostgreSQL</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Список доменов, ящиков, псевдонимов и паролей</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13.5px;color:rgba(245,246,247,.8);white-space:nowrap">локально</td>
                </tr>
                <tr>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);font-weight:600;white-space:nowrap">Certbot</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Сертификаты на все почтовые имена и их продление</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13.5px;color:rgba(245,246,247,.8);white-space:nowrap">80</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="a-place" data-sec style="padding:clamp(38px,5vw,60px) 0;border-top:1px solid rgba(245,246,247,.12);scroll-margin-top:88px">
          <div style="display:flex;align-items:baseline;gap:14px;margin-bottom:22px">
            <span style="font-family:'Silkscreen',ui-monospace,monospace;font-size:14px;color:#E8A94D">30</span>
            <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(21px,2.4vw,28px);line-height:1.22;margin:0;text-wrap:pretty">Где это живёт: выбор площадки</h2>
          </div>
          <div style="display:grid;gap:18px;max-width:64ch;margin-bottom:26px">
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Главное решается до установки: разрешит ли площадка исходящий порт 25 и даст ли собственную PTR-запись. Без первого письма не уйдут вовсе, без второго их не примут крупные почтовые службы.</p>
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Второй по важности вопрос — репутация адреса. IP из пула, с которого до вас рассылали спам, лечится только переездом, поэтому проверять адрес по чёрным спискам нужно сразу после выдачи, а не после первой жалобы.</p>
          </div>
          <p style="font-size:13.5px;line-height:1.55;color:rgba(245,246,247,.62);margin:0 0 14px;max-width:60ch">Данные из официальных FAQ, проверено в сентябре 2026. Уточняйте перед оплатой.</p>
          <div style="overflow-x:auto;border:1px solid rgba(245,246,247,.14);border-radius:12px">
            <table style="width:100%;min-width:620px;border-collapse:collapse;font-size:15px">
              <thead>
                <tr style="background:#242F3D;text-align:left">
                  <th style="padding:14px 18px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:rgba(245,246,247,.7);font-weight:600;white-space:nowrap">Тип площадки</th>
                  <th style="padding:14px 18px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:rgba(245,246,247,.7);font-weight:600;white-space:nowrap">Порт 25</th>
                  <th style="padding:14px 18px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:rgba(245,246,247,.7);font-weight:600;white-space:nowrap">PTR</th>
                  <th style="padding:14px 18px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:rgba(245,246,247,.7);font-weight:600;white-space:nowrap">Чего ждать</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);font-weight:600">VPS-хостинг общего профиля</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Закрыт, открывают по заявке</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Есть в панели</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Просят описать назначение рассылки, дальше без ограничений</td>
                </tr>
                <tr>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);font-weight:600">Крупное облако</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Закрыт, часто наглухо</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Есть</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Отправку предлагают через собственный сервис рассылок</td>
                </tr>
                <tr>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);font-weight:600">Выделенный сервер</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Открыт</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Своя подсеть</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Больше свободы и больше администрирования</td>
                </tr>
                <tr>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);font-weight:600">Дешёвый VPS по акции</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Как повезёт</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Иногда нет</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Адрес из «грязного» пула, письма в спаме с первого дня</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="a-relay" data-sec style="padding:clamp(38px,5vw,60px) 0;border-top:1px solid rgba(245,246,247,.12);scroll-margin-top:88px">
          <div style="display:flex;align-items:baseline;gap:14px;margin-bottom:22px">
            <span style="font-family:'Silkscreen',ui-monospace,monospace;font-size:14px;color:#E8A94D">40</span>
            <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(21px,2.4vw,28px);line-height:1.22;margin:0;text-wrap:pretty">Свой MX или релей</h2>
          </div>
          <div style="display:grid;gap:18px;max-width:64ch;margin-bottom:26px">
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Если порт 25 закрыт или адрес с плохой историей, отправку отдают релею: свой сервер принимает письмо от клиента и передаёт его наружу через сторонний узел с готовой репутацией. Приём при этом остаётся своим.</p>
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Мы выбрали свой MX и оставили релей как запасной путь: переключение — одна строка в конфигурации Postfix.</p>
          </div>
          <div data-code-block style="margin-bottom:26px;border:1px solid rgba(245,246,247,.1);border-radius:12px;background:#242F3D;overflow:hidden">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px 10px 18px;border-bottom:1px solid rgba(245,246,247,.1)">
              <span style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11.5px;letter-spacing:.07em;color:rgba(245,246,247,.62)">main.cf — отправка через релей</span>
              <button data-copy style="font-size:12px;font-weight:600;padding:6px 12px;border-radius:7px;border:1px solid rgba(245,246,247,.2);background:transparent;color:rgba(245,246,247,.78);cursor:pointer;flex-shrink:0">Копировать</button>
            </div>
            <pre style="margin:0;padding:20px;overflow-x:auto;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13.5px;line-height:1.7;color:rgba(245,246,247,.88)">relayhost = [smtp.relay.example]:587
smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = hash:/etc/postfix/sasl_passwd
smtp_sasl_security_options = noanonymous
smtp_tls_security_level = encrypt</pre>
          </div>
          <p style="font-size:13.5px;line-height:1.55;color:rgba(245,246,247,.62);margin:0 0 14px;max-width:60ch">Данные из официальных FAQ, проверено в сентябре 2026. Уточняйте перед оплатой.</p>
          <div style="overflow-x:auto;border:1px solid rgba(245,246,247,.14);border-radius:12px">
            <table style="width:100%;min-width:600px;border-collapse:collapse;font-size:15px">
              <thead>
                <tr style="background:#242F3D;text-align:left">
                  <th style="padding:14px 18px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:rgba(245,246,247,.7);font-weight:600;white-space:nowrap">Способ отправки</th>
                  <th style="padding:14px 18px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:rgba(245,246,247,.7);font-weight:600;white-space:nowrap">Репутация</th>
                  <th style="padding:14px 18px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:rgba(245,246,247,.7);font-weight:600;white-space:nowrap">Лимиты</th>
                  <th style="padding:14px 18px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:rgba(245,246,247,.7);font-weight:600;white-space:nowrap">Кому подходит</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);font-weight:600">Свой MX напрямую</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Своя, набирается месяцами</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Только чужие</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Чистый адрес, открытый порт 25, есть кому следить</td>
                </tr>
                <tr>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);font-weight:600">Релей провайдера</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Общая с соседями</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Есть, обычно суточные</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Порт 25 закрыт, писем немного</td>
                </tr>
                <tr>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);font-weight:600">Сервис рассылок</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Хорошая, с доставкой и отчётами</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Тариф за письма</td>
                  <td style="padding:14px 18px;border-top:1px solid rgba(245,246,247,.1);color:rgba(245,246,247,.8)">Уведомления из приложений, а не переписка людей</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="a-ask" data-sec style="padding:clamp(38px,5vw,60px) 0;border-top:1px solid rgba(245,246,247,.12);scroll-margin-top:88px">
          <div style="display:flex;align-items:baseline;gap:14px;margin-bottom:22px">
            <span style="font-family:'Silkscreen',ui-monospace,monospace;font-size:14px;color:#E8A94D">50</span>
            <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(21px,2.4vw,28px);line-height:1.22;margin:0;text-wrap:pretty">Что спросить у провайдера</h2>
          </div>
          <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0 0 24px;max-width:64ch;text-wrap:pretty">Шесть вопросов в поддержку до оплаты закрывают почти все сюрпризы. Ответы приходят за час, а переезд с неподходящей площадки занимает неделю.</p>
          <div style="display:grid;gap:14px;max-width:62ch;font-size:16px;line-height:1.62;color:rgba(245,246,247,.86)">
            <p style="margin:0;text-wrap:pretty">1. Открыт ли исходящий порт 25 и на каких условиях.</p>
            <p style="margin:0;text-wrap:pretty">2. Можно ли задать PTR-запись самостоятельно.</p>
            <p style="margin:0;text-wrap:pretty">3. Не числится ли выданный адрес в чёрных списках.</p>
            <p style="margin:0;text-wrap:pretty">4. Есть ли IPv6 и обязательно ли его использовать.</p>
            <p style="margin:0;text-wrap:pretty">5. Как делаются снимки диска и куда они складываются.</p>
            <p style="margin:0;text-wrap:pretty">6. Что происходит при жалобе на спам: предупреждение или отключение.</p>
          </div>
          <a href="/blog/hosting-checklist" style="display:inline-block;margin-top:24px;font-size:15px;font-weight:600;color:#E8A94D">Чек-лист выбора площадки →</a>
        </section>

        <section id="a-dns" data-sec style="padding:clamp(38px,5vw,60px) 0;border-top:1px solid rgba(245,246,247,.12);scroll-margin-top:88px">
          <div style="display:flex;align-items:baseline;gap:14px;margin-bottom:22px">
            <span style="font-family:'Silkscreen',ui-monospace,monospace;font-size:14px;color:#E8A94D">60</span>
            <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(21px,2.4vw,28px);line-height:1.22;margin:0;text-wrap:pretty">DNS: SPF, DKIM, DMARC, MTA-STS</h2>
          </div>
          <div style="display:grid;gap:18px;max-width:64ch;margin-bottom:26px">
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Три записи отвечают на три вопроса принимающей стороны: кому разрешено отправлять от имени домена, не менялось ли письмо в пути и что делать, если проверки не прошли. Четвёртая, MTA-STS, требует шифрования соединения.</p>
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Начинать стоит с <code style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:14px;background:#242F3D;padding:2px 6px;border-radius:5px">p=none</code>: отчёты уже приходят, но письма ещё не отбрасываются. Через пару недель, когда в отчётах не осталось неожиданных отправителей, политика ужесточается.</p>
          </div>
          <div data-code-block style="border:1px solid rgba(245,246,247,.1);border-radius:12px;background:#242F3D;overflow:hidden">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px 10px 18px;border-bottom:1px solid rgba(245,246,247,.1)">
              <span style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11.5px;letter-spacing:.07em;color:rgba(245,246,247,.62)">зона example.ru</span>
              <button data-copy style="font-size:12px;font-weight:600;padding:6px 12px;border-radius:7px;border:1px solid rgba(245,246,247,.2);background:transparent;color:rgba(245,246,247,.78);cursor:pointer;flex-shrink:0">Копировать</button>
            </div>
            <pre style="margin:0;padding:20px;overflow-x:auto;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13.5px;line-height:1.7;color:rgba(245,246,247,.88)">example.ru.            MX    10 mail.example.ru.
example.ru.            TXT   "v=spf1 mx -all"
dkim._domainkey        TXT   "v=DKIM1; k=rsa; p=MIIBIjANBg..."
_dmarc                 TXT   "v=DMARC1; p=none; rua=mailto:dmarc@example.ru"
_mta-sts               TXT   "v=STSv1; id=20260901"
mail.example.ru.       A     203.0.113.10</pre>
          </div>
        </section>

        <section id="a-tls" data-sec style="padding:clamp(38px,5vw,60px) 0;border-top:1px solid rgba(245,246,247,.12);scroll-margin-top:88px">
          <div style="display:flex;align-items:baseline;gap:14px;margin-bottom:22px">
            <span style="font-family:'Silkscreen',ui-monospace,monospace;font-size:14px;color:#E8A94D">70</span>
            <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(21px,2.4vw,28px);line-height:1.22;margin:0;text-wrap:pretty">Сертификаты</h2>
          </div>
          <div style="display:grid;gap:18px;max-width:64ch">
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Сертификат нужен на то имя, которое клиенты видят в настройках — обычно одно <code style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:14px;background:#242F3D;padding:2px 6px;border-radius:5px">mail.домен</code> на все ящики домена. Продление автоматическое, но Postfix и Dovecot нужно перезапускать после него, иначе они продолжат отдавать старый сертификат до следующей перезагрузки.</p>
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Обо что споткнулись: забытый хук перезапуска обнаружился через три месяца, когда сертификат истёк и клиенты перестали подключаться. Теперь это проверяется одной из сорока проверок состояния.</p>
          </div>
        </section>

        <section id="a-clients" data-sec style="padding:clamp(38px,5vw,60px) 0;border-top:1px solid rgba(245,246,247,.12);scroll-margin-top:88px">
          <div style="display:flex;align-items:baseline;gap:14px;margin-bottom:22px">
            <span style="font-family:'Silkscreen',ui-monospace,monospace;font-size:14px;color:#E8A94D">80</span>
            <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(21px,2.4vw,28px);line-height:1.22;margin:0;text-wrap:pretty">Клиенты и автонастройка</h2>
          </div>
          <div style="display:grid;gap:18px;max-width:64ch">
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Просить пользователя вписать имена серверов и номера портов — надёжный способ получить десять обращений в поддержку. Решается файлом автонастройки на веб-сервере домена: почтовые клиенты забирают параметры сами, человек вводит только адрес и пароль.</p>
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Приложения на телефонах подключаются по IMAP и SMTP без отдельной настройки. Веб-интерфейс мы не ставили: почта открывается в обычном клиенте, и это устроило всех.</p>
          </div>
        </section>

        <section id="a-move" data-sec style="padding:clamp(38px,5vw,60px) 0;border-top:1px solid rgba(245,246,247,.12);scroll-margin-top:88px">
          <div style="display:flex;align-items:baseline;gap:14px;margin-bottom:22px">
            <span style="font-family:'Silkscreen',ui-monospace,monospace;font-size:14px;color:#E8A94D">90</span>
            <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(21px,2.4vw,28px);line-height:1.22;margin:0;text-wrap:pretty">Переезд без потери писем</h2>
          </div>
          <div style="display:grid;gap:18px;max-width:64ch;margin-bottom:26px">
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Порядок такой: поднять новый сервер, перенести содержимое ящиков, проверить отправку и приём на тестовом домене и только потом переключить MX. Старый сервер остаётся принимать письма ещё несколько дней, пока DNS обновляется у всех.</p>
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Перенос повторяется без вреда: второй запуск догоняет письма, пришедшие за время первого.</p>
          </div>
          <div data-code-block style="border:1px solid rgba(245,246,247,.1);border-radius:12px;background:#242F3D;overflow:hidden">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px 10px 18px;border-bottom:1px solid rgba(245,246,247,.1)">
              <span style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11.5px;letter-spacing:.07em;color:rgba(245,246,247,.62)">перенос ящика</span>
              <button data-copy style="font-size:12px;font-weight:600;padding:6px 12px;border-radius:7px;border:1px solid rgba(245,246,247,.2);background:transparent;color:rgba(245,246,247,.78);cursor:pointer;flex-shrink:0">Копировать</button>
            </div>
            <pre style="margin:0;padding:20px;overflow-x:auto;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13.5px;line-height:1.7;color:rgba(245,246,247,.88)">imapsync \
  --host1 old.example.ru --user1 user@example.ru --password1 "***" \
  --host2 mail.example.ru --user2 user@example.ru --password2 "***" \
  --ssl1 --ssl2 --automap --delete2duplicates</pre>
          </div>
        </section>

        <section id="a-sec" data-sec style="padding:clamp(38px,5vw,60px) 0;border-top:1px solid rgba(245,246,247,.12);scroll-margin-top:88px">
          <div style="display:flex;align-items:baseline;gap:14px;margin-bottom:22px">
            <span style="font-family:'Silkscreen',ui-monospace,monospace;font-size:14px;color:#E8A94D">100</span>
            <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(21px,2.4vw,28px);line-height:1.22;margin:0;text-wrap:pretty">Безопасность</h2>
          </div>
          <div style="display:grid;gap:18px;max-width:64ch">
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Почтовый сервер перебирают пароли с первого дня — это видно в журналах через несколько часов после запуска. Помогают три вещи: блокировка адресов после серии неудачных попыток, отказ от аутентификации без шифрования и длинные пароли ящиков, выдаваемые генератором, а не пользователем.</p>
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Отдельно проверяется, что сервер не стал открытым релеем: отправка разрешена только после аутентификации, и это есть в списке проверок. Взломанный ящик, рассылающий спам, лишает репутации весь домен за сутки.</p>
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Резервные копии снимаются с ящиков и базы, лежат вне сервера и раз в квартал восстанавливаются на чистую машину.</p>
            <p style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(18px,2vw,23px);line-height:1.42;color:#F5F6F7;margin:10px 0 0;max-width:32ch;text-wrap:pretty">Копия, которую никогда не разворачивали, копией не считается.</p>
          </div>
        </section>

        <section id="a-end" data-sec style="padding:clamp(38px,5vw,60px) 0;border-top:1px solid rgba(245,246,247,.12);scroll-margin-top:88px">
          <div style="display:flex;align-items:baseline;gap:14px;margin-bottom:22px">
            <span style="font-family:'Silkscreen',ui-monospace,monospace;font-size:14px;color:#E8A94D">110</span>
            <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(21px,2.4vw,28px);line-height:1.22;margin:0;text-wrap:pretty">Итоги</h2>
          </div>
          <div style="display:grid;gap:18px;max-width:64ch">
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Своя почта — это не сложно настроить, а нужно поддерживать: следить за сертификатами, репутацией, копиями и обновлениями. Установка занимает вечер, эксплуатация — постоянные полчаса в месяц и один разбор в квартал.</p>
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Брать это стоит, когда домены свои, требования к данным жёсткие, а администратор всё равно есть. Если ящиков пять и админа нет, аренда честно дешевле.</p>
            <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Развёртывание и проверки мы собрали в открытый репозиторий: одна команда поднимает стек, вторая прогоняет сорок проверок и показывает, что именно не в порядке.</p>
          </div>
        </section>

        <section style="padding:clamp(34px,4vw,52px) 0 clamp(64px,9vw,112px);border-top:1px solid rgba(245,246,247,.12)">
          <div style="display:flex;flex-wrap:wrap;gap:12px 24px;font-size:15.5px;font-weight:600">
            <a href="https://github.com/aplicon-ru" target="_blank" rel="noopener" style="color:#E8A94D">Репозиторий на GitHub ↗</a>
            <span style="color:rgba(245,246,247,.3)">·</span>
            <a href="/blog/hosting-checklist" style="color:#E8A94D">Чек-лист выбора площадки →</a>
            <span style="color:rgba(245,246,247,.3)">·</span>
            <a href="/blog" style="color:#E8A94D">Другие статьи →</a>
          </div>
        </section>

      </div>
    </div>
  </main>
</Layout>

<script>
  const toc = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc]"));
  const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-sec]"));
  const bar = document.getElementById("reading-progress");

  const setActive = (id: string | null) => {
    toc.forEach(l => {
      l.style.color = l.dataset.toc === id ? "#E8A94D" : "rgba(245,246,247,.62)";
    });
  };

  const io = new IntersectionObserver(
    (entries) => {
      const visible = entries.filter(e => e.isIntersecting);
      if (visible.length) setActive((visible[0].target as HTMLElement).id);
    },
    { rootMargin: "-110px 0px -70% 0px" }
  );
  sections.forEach(s => io.observe(s));

  const onScroll = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const pct = max > 40 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0;
    if (bar) bar.style.width = pct + "%";
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach(btn => {
    btn.addEventListener("click", () => {
      const box = btn.closest("[data-code-block]");
      const pre = box ? box.querySelector("pre") : null;
      if (!pre || !navigator.clipboard) return;
      navigator.clipboard.writeText(pre.textContent || "").then(() => {
        const old = btn.textContent;
        btn.textContent = "Скопировано";
        setTimeout(() => { btn.textContent = old; }, 1600);
      });
    });
  });
</script>
