---
import Layout from "../layouts/Layout.astro";
import { programs, format } from "../data/learning.json";
---
<Layout title="Обучение — Апликон">
  <main>
    <section style="max-width:1220px;margin:0 auto;padding:clamp(48px,6vw,88px) 24px clamp(36px,4vw,56px)">
      <div style="font-size:12.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:#E8A94D;margin-bottom:18px">Курсы и программы</div>
      <h1 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(30px,4.4vw,50px);line-height:1.12;margin:0 0 20px;max-width:24ch;text-wrap:pretty">Учим на реальных проектах, а не на учебных примерах</h1>
      <p style="font-size:clamp(16px,1.3vw,18px);line-height:1.62;color:rgba(245,246,247,.72);max-width:62ch;margin:0;text-wrap:pretty">Программы ведут инженеры, которые сейчас работают над задачами Апликона. Материал курса — код и данные из практики, а не синтетические задачи.</p>
    </section>
    <section style="max-width:1220px;margin:0 auto;padding:0 24px clamp(44px,5vw,72px)">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px">
        {programs.map(p => (
          <div style="background:#242F3D;border:1px solid rgba(245,246,247,.09);border-radius:16px;padding:30px;display:flex;flex-direction:column;gap:16px">
            <div style="display:flex;justify-content:space-between;gap:12px;align-items:baseline">
              <span style="font-size:12.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#E8A94D">{p.kind}</span>
              <span style="font-size:13.5px;color:rgba(245,246,247,.6)">{p.dur}</span>
            </div>
            <h3 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:21px;margin:0;line-height:1.24">{p.title}</h3>
            <p style="font-size:15px;line-height:1.6;color:rgba(245,246,247,.72);margin:0">{p.text}</p>
            <div style="margin-top:auto;padding-top:10px;font-size:13.5px;color:rgba(245,246,247,.6);border-top:1px solid rgba(245,246,247,.12)">{p.note}</div>
          </div>
        ))}
      </div>
    </section>
    <section style="border-top:1px solid rgba(245,246,247,.09)">
      <div style="max-width:1220px;margin:0 auto;padding:clamp(44px,6vw,80px) 24px;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:26px">
        {format.map(f => (
          <div>
            <div style="font-family:'Unbounded',sans-serif;font-size:15px;color:#E8A94D;margin-bottom:12px">{f.title}</div>
            <p style="font-size:15px;line-height:1.6;color:rgba(245,246,247,.72);margin:0">{f.text}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>
