---
import Layout from "../../layouts/Layout.astro";

const canDo = [
  { title: "Контингент", text: "Личные дела, студенческие билеты, зачётные книжки, движение: перевод, отпуск, восстановление." },
  { title: "Учебные планы", text: "Планы и программы в машиночитаемом виде, а не в файлах Word." },
  { title: "Приказы", text: "Формируются из данных учёта, а не набираются руками заново." },
  { title: "Личные кабинеты", text: "Студент и преподаватель видят своё, с телефона." },
  { title: "Выгрузки", text: "Государственные системы получают данные из одного источника." },
];

const decisions = [
  { title: "Учёт живёт в 1С", why: "Почему: 1С уже стоит в большинстве организаций, кадры и бухгалтерия рядом. Не заводим ещё один остров данных." },
  { title: "Модули общаются по описанным контрактам", why: "Почему: контракт проверяется машиной, поэтому обновление одного модуля не ломает соседний незаметно." },
  { title: "Кабинеты работают офлайн", why: "Почему: в аудиториях и общежитиях связь плохая. Данные хранятся на устройстве и досинхронизируются потом." },
  { title: "Ставится на серверы заказчика", why: "Почему: данные организации остаются у организации." },
];

const otherProducts = [
  { name: "Архикон", status: "в разработке" },
  { name: "Ярлыкон", status: "работает" },
  { name: "Метакон", status: "замысел" },
  { name: "Тестикон", status: "замысел" },
];

function badgeStyle(status: string) {
  if (status === "работает") return "border:1px solid rgba(232,169,77,.55);color:#E8A94D";
  return "border:1px solid rgba(245,246,247,.28);color:rgba(245,246,247,.62)";
}
---
<Layout title="Универкон — Апликон" active="works">
  <main>
    <section style="max-width:760px;margin:0 auto;padding:clamp(40px,5vw,72px) 24px clamp(30px,4vw,48px)">
      <div style="display:flex;flex-wrap:wrap;align-items:baseline;gap:8px;font-size:13px;color:rgba(245,246,247,.6);margin-bottom:clamp(24px,3vw,36px)">
        <a href="/works" style="color:rgba(245,246,247,.6)">Работы</a>
        <span style="color:rgba(245,246,247,.35)">→</span>
        <a href="/works#works-products" style="color:rgba(245,246,247,.6)">Продукты</a>
        <span style="color:rgba(245,246,247,.35)">→</span>
        <span>Универкон</span>
      </div>
      <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px">
        <h1 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(32px,5vw,54px);line-height:1.1;margin:0">Универкон</h1>
        <span style="font-size:12px;letter-spacing:.04em;padding:5px 12px;border-radius:99px;border:1px solid rgba(245,246,247,.28);color:rgba(245,246,247,.62);white-space:nowrap">в разработке</span>
      </div>
      <p style="font-size:clamp(16px,1.4vw,19px);line-height:1.6;color:rgba(245,246,247,.82);margin:18px 0 0;text-wrap:pretty">Управление вузом, колледжем и центром ДПО.</p>
      <div style="display:flex;flex-wrap:wrap;gap:10px 24px;margin-top:26px;font-size:15px;font-weight:600">
        <a href="#" target="_blank" rel="noopener" style="color:#E8A94D">GitHub ↗</a>
        <span style="color:rgba(245,246,247,.3)">·</span>
        <a href="/contact" style="color:#E8A94D">Написать нам →</a>
      </div>
    </section>

    <nav id="product-toc" style="position:sticky;top:56px;z-index:40;background:rgba(26,36,48,.92);backdrop-filter:blur(14px);border-top:1px solid rgba(245,246,247,.14);border-bottom:1px solid rgba(245,246,247,.09)">
      <div style="max-width:760px;margin:0 auto;padding:0 24px;display:flex;gap:20px;overflow-x:auto;font-size:13.5px;font-weight:600;white-space:nowrap">
        <a href="#p-task" data-toc="p-task" style="padding:13px 0;color:rgba(245,246,247,.66);border-bottom:2px solid transparent">Задача</a>
        <a href="#p-can" data-toc="p-can" style="padding:13px 0;color:rgba(245,246,247,.66);border-bottom:2px solid transparent">Что умеет</a>
        <a href="#p-decisions" data-toc="p-decisions" style="padding:13px 0;color:rgba(245,246,247,.66);border-bottom:2px solid transparent">Решения</a>
        <a href="#p-not" data-toc="p-not" style="padding:13px 0;color:rgba(245,246,247,.66);border-bottom:2px solid transparent">Чего не делаем</a>
        <a href="#p-state" data-toc="p-state" style="padding:13px 0;color:rgba(245,246,247,.66);border-bottom:2px solid transparent">Состояние</a>
        <a href="#p-tech" data-toc="p-tech" style="padding:13px 0;color:rgba(245,246,247,.66);border-bottom:2px solid transparent">Технологии</a>
      </div>
    </nav>

    <section id="p-task" data-sec style="max-width:760px;margin:0 auto;padding:clamp(34px,4vw,52px) 24px;scroll-margin-top:104px">
      <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(20px,2.2vw,26px);line-height:1.22;margin:0 0 22px">Какую задачу решает</h2>
      <div style="display:grid;gap:18px;max-width:64ch">
        <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Учебное заведение обязано вести контингент, планы, приказы и оценки, а потом отдавать эти данные в государственные системы и показывать на сайте. Обычно каждый кусок живёт в своей программе или в своём файле.</p>
        <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Данные начинают расходиться незаметно: в приказе одно, в ведомости другое, на сайте третье. Обнаруживается это на проверке.</p>
        <p style="font-size:16.5px;line-height:1.68;color:rgba(245,246,247,.82);margin:0;text-wrap:pretty">Универкон собирает всё в один учёт, из которого берутся и отчёты, и выгрузки, и личные кабинеты.</p>
      </div>
    </section>

    <section id="p-can" data-sec style="max-width:760px;margin:0 auto;padding:clamp(34px,4vw,52px) 24px;border-top:1px solid rgba(245,246,247,.14);scroll-margin-top:104px">
      <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(20px,2.2vw,26px);line-height:1.22;margin:0 0 20px">Что умеет</h2>
      <div style="display:grid">
        {canDo.map(c => (
          <div class="ap-2col" style="display:grid;grid-template-columns:minmax(0,190px) minmax(0,1fr);gap:6px clamp(12px,3vw,32px);padding:18px 0;border-top:1px solid rgba(245,246,247,.1)">
            <div style="font-size:16px;font-weight:700;line-height:1.4">{c.title}</div>
            <p style="font-size:15.5px;line-height:1.6;color:rgba(245,246,247,.76);margin:0;text-wrap:pretty">{c.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="p-decisions" data-sec style="max-width:760px;margin:0 auto;padding:clamp(34px,4vw,52px) 24px;border-top:1px solid rgba(245,246,247,.14);scroll-margin-top:104px">
      <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(20px,2.2vw,26px);line-height:1.22;margin:0 0 20px">Ключевые решения</h2>
      <div style="display:grid;gap:26px;max-width:64ch">
        {decisions.map(d => (
          <div>
            <div style="font-size:16.5px;font-weight:700;line-height:1.45;margin-bottom:8px;text-wrap:pretty">{d.title}</div>
            <p style="font-size:15px;line-height:1.62;color:rgba(245,246,247,.62);margin:0;text-wrap:pretty">{d.why}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="p-not" data-sec style="max-width:760px;margin:0 auto;padding:clamp(34px,4vw,52px) 24px;border-top:1px solid rgba(245,246,247,.14);scroll-margin-top:104px">
      <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(20px,2.2vw,26px);line-height:1.22;margin:0 0 20px">Чего не делаем</h2>
      <div style="display:grid;gap:12px;max-width:62ch;font-size:15.5px;line-height:1.62;color:rgba(245,246,247,.66)">
        <p style="margin:0;text-wrap:pretty">Не заменяем бухгалтерию и кадры — работаем рядом с ними.</p>
        <p style="margin:0;text-wrap:pretty">Не делаем облачную версию с хранением данных у нас.</p>
        <p style="margin:0;text-wrap:pretty">Не подменяем систему дистанционного обучения — интегрируемся.</p>
      </div>
    </section>

    <section id="p-state" data-sec style="max-width:760px;margin:0 auto;padding:clamp(34px,4vw,52px) 24px;border-top:1px solid rgba(245,246,247,.14);scroll-margin-top:104px">
      <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(20px,2.2vw,26px);line-height:1.22;margin:0 0 18px">Состояние</h2>
      <p style="font-size:16.5px;line-height:1.62;color:rgba(245,246,247,.82);margin:0 0 clamp(26px,3vw,36px);max-width:60ch;text-wrap:pretty">Ядро учёта и кабинеты — в работе. Выгрузки в государственные системы — проектируются.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:2px 14px">
        <div style="padding-top:12px;border-top:2px solid rgba(245,246,247,.3)">
          <div style="font-size:15px;font-weight:600;color:rgba(245,246,247,.66)">Модель</div>
          <div style="font-size:12.5px;color:rgba(245,246,247,.62);margin-top:4px">готово</div>
        </div>
        <div style="padding-top:12px;border-top:2px solid #E8A94D">
          <div style="font-size:15px;font-weight:600;color:#E8A94D">Ядро учёта</div>
          <div style="font-size:12.5px;color:#E8A94D;margin-top:4px">сейчас</div>
        </div>
        <div style="padding-top:12px;border-top:2px solid #E8A94D">
          <div style="font-size:15px;font-weight:600;color:#E8A94D">Кабинеты</div>
          <div style="font-size:12.5px;color:#E8A94D;margin-top:4px">сейчас</div>
        </div>
        <div style="padding-top:12px;border-top:2px solid rgba(245,246,247,.18)">
          <div style="font-size:15px;font-weight:600;color:rgba(245,246,247,.62)">Выгрузки</div>
          <div style="font-size:12.5px;color:rgba(245,246,247,.62);margin-top:4px">проектируются</div>
        </div>
      </div>
    </section>

    <section id="p-tech" data-sec style="max-width:760px;margin:0 auto;padding:clamp(34px,4vw,52px) 24px;border-top:1px solid rgba(245,246,247,.14);scroll-margin-top:104px">
      <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(20px,2.2vw,26px);line-height:1.22;margin:0 0 18px">Технологии</h2>
      <p style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13px;line-height:1.6;color:#E8A94D;margin:0 0 18px">1С:Предприятие · БСП · Go · TypeScript · React · PWA · Docker</p>
      <a href="/tech" style="font-size:15px;font-weight:600;color:#E8A94D">Как мы выбираем инструменты →</a>
    </section>

    <section style="max-width:760px;margin:0 auto;padding:clamp(34px,4vw,52px) 24px;border-top:1px solid rgba(245,246,247,.14)">
      <h2 style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:clamp(21px,2.4vw,28px);line-height:1.2;margin:0 0 14px;text-wrap:pretty">Хотите такое же у себя?</h2>
      <p style="font-size:16.5px;line-height:1.62;color:rgba(245,246,247,.82);margin:0 0 18px;max-width:56ch;text-wrap:pretty">Мы берём немного проектов и сначала разбираемся в вашем устройстве.</p>
      <a href="/contact" style="font-size:16px;font-weight:600;color:#E8A94D">Написать →</a>
    </section>

    <section style="max-width:760px;margin:0 auto;padding:clamp(34px,4vw,52px) 24px clamp(64px,9vw,112px);border-top:1px solid rgba(245,246,247,.14)">
      <div style="font-size:12.5px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:rgba(245,246,247,.62);margin-bottom:20px">Другие продукты</div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:18px 24px">
        {otherProducts.map(p => (
          <a href="/works#works-products" style="display:grid;gap:8px;justify-items:start;color:#F5F6F7">
            <span style="font-family:'Unbounded',sans-serif;font-weight:500;font-size:16px">{p.name}</span>
            <span style={`font-size:11.5px;letter-spacing:.04em;padding:4px 10px;border-radius:99px;${badgeStyle(p.status)}`}>{p.status}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc]"));
  const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-sec]"));
  const setActive = (id: string | null) => {
    links.forEach(l => {
      const active = l.dataset.toc === id;
      l.style.color = active ? "#E8A94D" : "rgba(245,246,247,.66)";
      l.style.borderBottomColor = active ? "#E8A94D" : "transparent";
    });
  };
  const io = new IntersectionObserver(
    (entries) => {
      const visible = entries.filter(e => e.isIntersecting);
      if (visible.length) setActive((visible[0].target as HTMLElement).id);
    },
    { rootMargin: "-110px 0px -70% 0px" }
  );
  sections.forEach(s => io.observe(s));
</script>
