---
import "../styles/tokens.css";

export interface Props {
  title: string;
  description?: string;
  active?: "works" | "team" | "contact" | null;
}

const { title, description = "Апликон — разработка, исследование, обучение, инновации.", active = null } = Astro.props;

const navColor = (key: string) => (key === active ? "#E8A94D" : "rgba(245,246,247,.68)");
---

<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600&family=Manrope:wght@400;500;600;700&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet" />
  <style is:global>
    html, body { margin: 0; padding: 0; background: #1A2430; }
    body { font-family: "Manrope", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
    * { box-sizing: border-box; }
    a { color: #E8A94D; text-decoration: none; }
    a:hover { color: #F3C67F; }
    ::selection { background: #E8A94D; color: #1A2430; }
  </style>
</head>
<body>
  <div style="background:#1A2430;color:#F5F6F7;min-height:100vh;overflow-x:clip;font-size:16px">

    <header style="position:sticky;top:0;z-index:50;backdrop-filter:blur(14px);background:rgba(26,36,48,.85);border-bottom:1px solid rgba(245,246,247,.09)">
      <div style="max-width:1220px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;gap:20px;flex-wrap:nowrap">
        <a href="/" style="display:flex;align-items:center;gap:12px;color:#F5F6F7;flex-shrink:0">
          <img src="/logo-aplicon.svg" alt="Апликон" style="display:block;height:30px;width:auto" />
        </a>
        <nav style="display:flex;gap:clamp(11px,1.5vw,26px);flex:1 1 auto;min-width:0;justify-content:flex-end;flex-wrap:wrap;font-size:clamp(12.5px,1.15vw,14.5px);font-weight:500">
          <a href="/works" style={`color:${navColor("works")}`}>Работы</a>
          <a href="/team" style={`color:${navColor("team")}`}>Команда</a>
          <a href="/contact" style={`color:${navColor("contact")}`}>Контакты</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer style="border-top:1px solid rgba(245,246,247,.09);background:#1A2430">
      <div style="max-width:1220px;margin:0 auto;padding:clamp(40px,5vw,60px) 24px;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:32px">
        <div>
          <img src="/logo-aplicon.svg" alt="Апликон" style="display:block;height:32px;width:auto;margin-bottom:16px" />
          <p style="font-size:13.5px;line-height:1.55;color:rgba(245,246,247,.68);margin:0;max-width:34ch">Разработка · Исследование · Обучение · Инновации</p>
        </div>
        <div style="display:grid;gap:10px;align-content:start;font-size:14.5px">
          <div style="font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;color:rgba(245,246,247,.62);margin-bottom:4px">Команда</div>
          <a href="/works" style="color:rgba(245,246,247,.78)">Работы</a>
          <a href="/team" style="color:rgba(245,246,247,.78)">Команда</a>
          <a href="/services" style="color:rgba(245,246,247,.78)">Услуги</a>
          <a href="/research" style="color:rgba(245,246,247,.78)">Исследования</a>
          <a href="/learning" style="color:rgba(245,246,247,.78)">Обучение</a>
          <a href="/tech" style="color:rgba(245,246,247,.78)">Технологии</a>
        </div>
        <div style="display:grid;gap:10px;align-content:start;font-size:14.5px">
          <div style="font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;color:rgba(245,246,247,.62);margin-bottom:4px">Компания</div>
          <a href="/legal" style="color:rgba(245,246,247,.78)">О компании и реквизиты</a>
          <a href="/privacy" style="color:rgba(245,246,247,.78)">Политика конфиденциальности</a>
          <a href="/blog" style="color:rgba(245,246,247,.78)">Блог</a>
          <a href="https://academ.aplicon.ru" target="_blank" rel="noopener" style="color:rgba(245,246,247,.78)">Академия iMiron ↗</a>
          <a href="https://github.com/aplicon-ru" target="_blank" rel="noopener" style="color:rgba(245,246,247,.78)">GitHub ↗</a>
        </div>
        <div style="display:grid;gap:10px;align-content:start;font-size:14.5px">
          <div style="font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;color:rgba(245,246,247,.62);margin-bottom:4px">Связь</div>
          <a href="mailto:hello@aplicon.ru" style="color:rgba(245,246,247,.78)">hello@aplicon.ru</a>
          <span style="color:rgba(245,246,247,.78)">+7 000 000-00-00</span>
        </div>
      </div>
      <div style="max-width:1220px;margin:0 auto;padding:0 24px 34px;font-size:12.5px;color:rgba(245,246,247,.62)">© 2026 ООО «Апликон»</div>
    </footer>

  </div>
</body>
</html>
